NODE_ENV=development
PORT=8080
# Dominios del frontend, separados por comas. Obligatoria en producción (no admite '*').
# En local, si se deja vacía, solo se aceptan orígenes de localhost / 127.0.0.1.
CORS_ORIGINS=
# URL interna de cada microservicio (en Railway: http://<servicio>.railway.internal:<puerto>).
AUTH_SERVICE_URL=http://localhost:3001
ACCOUNT_SERVICE_URL=http://localhost:3002
KYC_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3005
LEDGER_SERVICE_URL=http://localhost:3006
CARD_SERVICE_URL=http://localhost:3007
TRANSFER_SERVICE_URL=http://localhost:3008
FRAUD_SERVICE_URL=http://localhost:3009
COMPLIANCE_SERVICE_URL=http://localhost:3010
PAYMENT_SERVICE_URL=http://localhost:3011
REWARDS_SERVICE_URL=http://localhost:3012
SAVINGS_SERVICE_URL=http://localhost:3013

# Opcionales (estos son los valores por defecto).
# Tiempo máximo de espera de un microservicio antes de responder 504.
PROXY_TIMEOUT_MS=15000
# Límites por IP y por minuto: global, rutas sensibles (login, registro) y envío de códigos.
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_SENSITIVE_PER_MIN=20
RATE_LIMIT_VERIFY_PER_MIN=10
